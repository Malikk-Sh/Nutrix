<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nutrix" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nutrix_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/nutrix_teal</item>
    </style>

    <style name="Theme.Nutrix.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nutrix_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Nutrix</item>
    </style>
</resources>
